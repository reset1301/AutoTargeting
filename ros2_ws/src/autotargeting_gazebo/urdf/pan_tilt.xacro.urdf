<?xml version="1.0"?>
<!-- Упрощённый pan-tilt для Gazebo Fortress: два вращательных сустава 0…π рад (0…180°). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pan_tilt_sim">
  <link name="world"/>

  <link name="base_link">
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><box size="0.2 0.2 0.05"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><box size="0.2 0.2 0.05"/></geometry>
      <material name="grey"><color rgba="0.4 0.4 0.45 1"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="pan_link">
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.14 0.06 0.06"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.14 0.06 0.06"/></geometry>
      <material name="green"><color rgba="0.2 0.75 0.3 1"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <link name="tilt_link">
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.12"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.12"/></geometry>
      <material name="blue"><color rgba="0.2 0.35 0.85 1"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <link name="camera_link">
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.08 0.06 0.04"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.08 0.06 0.04"/></geometry>
      <material name="orange"><color rgba="0.95 0.55 0.1 1"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>

  <joint name="pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="pan_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="15" lower="0" upper="3.141592653589793" velocity="2"/>
    <dynamics damping="0.5" friction="0"/>
  </joint>

  <joint name="tilt_joint" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="15" lower="0" upper="3.141592653589793" velocity="2"/>
    <dynamics damping="0.5" friction="0"/>
  </joint>

  <joint name="tilt_to_camera" type="fixed">
    <parent link="tilt_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="pan_joint">
      <command_interface name="position">
        <param name="min">0</param>
        <param name="max">3.141592653589793</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">1.5707963267948966</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="tilt_joint">
      <command_interface name="position">
        <param name="min">0</param>
        <param name="max">3.141592653589793</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">1.5707963267948966</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find autotargeting_gazebo)/config/pan_tilt_controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
