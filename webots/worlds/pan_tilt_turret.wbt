#VRML_SIM R2025a utf8
# AutoTargeting: pan-tilt турель + шар на эллипсе.
# File → Open World → Run (▶). Турель — supervisor (двигает TARGET_BALL).

EXTERNPROTO "../protos/PanTiltTurret.proto"

WorldInfo {
  title "AutoTargeting Pan-Tilt Turret Tracking"
  basicTimeStep 16
  coordinateSystem "ENU"
}
# Тот же угол обзора (пол горизонтальный), камера дальше — видна вся турель, не крупный план пола.
Viewpoint {
  orientation -0.4 0.5 0.75 1.2
  position -7.0 -12.0 15.0
}
Background {
  skyColor [
    0.45 0.65 0.9
  ]
}
DirectionalLight {
  ambientIntensity 0.55
  direction 0.3 -0.5 -1
  intensity 1.2
  castShadows TRUE
}
Solid {
  translation 0 0 -0.005
  name "floor"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.55 0.58 0.52
        roughness 0.9
        metalness 0
      }
      geometry Box {
        size 12 12 0.01
      }
    }
  ]
  boundingObject Box {
    size 12 12 0.01
  }
}
# Стартовая точка на переднем эллипсе (center_x = A+1.5 = 5.0 при A=3.5).
DEF TARGET_BALL Solid {
  translation 5 0 3.5
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.15 0.12
        roughness 0.35
        metalness 0.05
      }
      geometry Sphere {
        radius 0.035
        subdivision 3
      }
    }
  ]
  name "target_ball"
  boundingObject Sphere {
    radius 0.035
  }
}
PanTiltTurret {
  translation 0 0 0
  name "pan_tilt_turret"
  controller "pan_tilt_demo"
  supervisor TRUE
}
